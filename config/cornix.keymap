/*
 * Cornix LP keymap, translated 2026-10-24 from the RMK/Vial layout
 * (~/.config/cornix/backups/zmk_trial_20261024/cornix_full_backup_20261024.vil).
 *
 * Position map (50 keys):
 *   0- 5 | 6-11      top row, left outer->inner | right inner->outer
 *  12-17 | 18-23     home row
 *  24-29 30 31 32-37 bottom row, 30/31 = inner extra keys (encoder push: Mute / middle click)
 *  38-40 41-43 | 44-46 47-49   left palm (outer->inner), left thumbs (outer->inner) | right thumbs (inner->outer), right palm (inner->outer)
 *
 * Layers: 0 Linux base, 1 Mac (thin overlay: Ctrl<->Gui), 2 Nav, 3 NavMac (auto when 1+2),
 *         4 Fun, 5 Num (hold Space), 6 Sym (hold Tab).
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE 0
#define MAC  1
#define NAV  2
#define NAVM 3
#define FUN  4
#define NUM  5
#define SYM  6

// hand groups for positional (chordal) hold-tap
#define KEYS_L 0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 30 38 39 40
#define KEYS_R 6 7 8 9 10 11 18 19 20 21 22 23 31 32 33 34 35 36 37 47 48 49
#define THUMBS 41 42 43 44 45 46

// timing (Vial at migration time: tapping term 190, flow tap 70, permissive hold on)
#define HRM_TERM   200
#define HRM_IDLE   100   // flow tap for home-row mods only
#define SPC_TERM   170   // Space layer key: shorter term, NO prior-idle
#define FUN_TERM   200

/ {
    behaviors {
        // home-row mods: balanced == permissive hold; hold-trigger = opposite hand + thumbs
        hml: hml {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;
            flavor = "balanced";
            tapping-term-ms = <HRM_TERM>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <HRM_IDLE>;
            hold-trigger-key-positions = <KEYS_R THUMBS>;
            hold-trigger-on-release;
        };
        hmr: hmr {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;
            flavor = "balanced";
            tapping-term-ms = <HRM_TERM>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <HRM_IDLE>;
            hold-trigger-key-positions = <KEYS_L THUMBS>;
            hold-trigger-on-release;
        };
        // shift variants: same for now, kept separate so they can be tuned alone
        hsl: hsl {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;
            flavor = "balanced";
            tapping-term-ms = <HRM_TERM>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <HRM_IDLE>;
            hold-trigger-key-positions = <KEYS_R THUMBS>;
            hold-trigger-on-release;
        };
        hsr: hsr {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;
            flavor = "balanced";
            tapping-term-ms = <HRM_TERM>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <HRM_IDLE>;
            hold-trigger-key-positions = <KEYS_L THUMBS>;
            hold-trigger-on-release;
        };
        // Space -> Num: short term, no flow-tap, so "type letters then immediately hold space + digit" works
        lt_spc: lt_spc {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&mo>, <&kp>;
            flavor = "balanced";
            tapping-term-ms = <SPC_TERM>;
            quick-tap-ms = <150>;   // double-tap space = held space (auto-repeat)
        };
        // Esc -> Fun
        lt_fun: lt_fun {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&mo>, <&kp>;
            flavor = "balanced";
            tapping-term-ms = <FUN_TERM>;
            quick-tap-ms = <150>;
        };
        // one-shot shift (RMK OSM equivalent); released after next key or 1.5 s
        skq: skq {
            compatible = "zmk,behavior-sticky-key";
            #binding-cells = <1>;
            bindings = <&kp>;
            release-after-ms = <1500>;
            quick-release;
            ignore-modifiers;
        };
        // right encoder = scroll
        scroll_enc: scroll_enc {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;
        };
    };

    macros {
        m_email_p: m_email_p {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <5>;
            tap-ms = <5>;
            bindings = <&kp LANG2>, <&macro_wait_time 50>, <&kp P>, <&kp I>, <&kp X>, <&kp E>, <&kp L>, <&kp H>, <&kp E>, <&kp G>, <&kp E>, <&kp L>, <&kp AT>, <&kp G>, <&kp M>, <&kp A>, <&kp I>, <&kp L>, <&kp DOT>, <&kp C>, <&kp O>, <&kp M>;
        };  // personal email

        m_email_w: m_email_w {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <5>;
            tap-ms = <5>;
            bindings = <&kp LANG2>, <&macro_wait_time 50>, <&kp L>, <&kp A>, <&kp W>, <&kp R>, <&kp E>, <&kp N>, <&kp C>, <&kp E>, <&kp DOT>, <&kp Z>, <&kp AT>, <&kp B>, <&kp I>, <&kp N>, <&kp A>, <&kp N>, <&kp C>, <&kp E>, <&kp DOT>, <&kp C>, <&kp O>, <&kp M>;
        };  // work email

        m_000: m_000 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <5>;
            tap-ms = <5>;
            bindings = <&kp N0>, <&kp N0>, <&kp N0>;
        };  // 000

        // one key = monitor to Mac (Ctrl+Alt+F14 to the current host), then BT profile 1, then Mac layer
        to_mac: to_mac {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            bindings = <&kp LC(LA(F14))>, <&macro_wait_time 300>, <&bt BT_SEL 1>, <&to MAC>;
        };
        to_linux: to_linux {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            bindings = <&kp LC(LA(F13))>, <&macro_wait_time 300>, <&bt BT_SEL 0>, <&to BASE>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";
        nav_mac {
            if-layers = <MAC NAV>;
            then-layer = <NAVM>;
        };
    };

    combos {
        compatible = "zmk,combos";
        // J+K -> (   K+L -> )   (Vial combo term 30 ms)
        cb_lpar {
            bindings = <&kp LPAR>;
            key-positions = <19 20>;
            timeout-ms = <30>;
            layers = <BASE MAC>;
        };
        cb_rpar {
            bindings = <&kp RPAR>;
            key-positions = <20 21>;
            timeout-ms = <30>;
            layers = <BASE MAC>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "Linux";
            bindings = <
                &kp TAB  &kp Q  &kp W  &kp E  &kp R  &kp T  &kp Y  &kp U  &kp I  &kp O  &kp P  &kp BSPC
                &kp LC(SPACE)  &hml LALT A  &hml LCTRL S  &hml LGUI D  &hsl LSHFT F  &kp G  &kp H  &hsr RSHFT J  &hmr RGUI K  &hmr RCTRL L  &hmr RALT SQT  &kp SQT
                &skq LSHFT  &kp Z  &kp X  &kp C  &kp V  &kp B  &kp C_MUTE  &mkp MCLK  &kp N  &kp M  &kp COMMA  &kp DOT  &kp FSLH  &kp FSLH
                &kp LCTRL  &kp LALT  &kp LGUI  &lt_fun FUN ESC  &mo SYM  &lt_spc NUM SPACE  &kp RET  &mo NAV  &kp DEL  &kp RGUI  &kp MINUS  &kp PSCRN
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &scroll_enc>;
        };

        mac_layer {
            display-name = "Mac";
            bindings = <
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &hml LALT A  &hml LGUI S  &hml LCTRL D  &trans  &trans  &trans  &trans  &hmr RCTRL K  &hmr RGUI L  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &kp LGUI  &kp LALT  &kp LCTRL  &trans  &trans  &trans  &trans  &trans  &trans  &kp RCTRL  &trans  &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &scroll_enc>;
        };

        nav_layer {
            display-name = "Nav";
            bindings = <
                &to_linux  &none  &none  &none  &none  &none  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT  &none  &none
                &to_mac  &kp LALT  &kp LCTRL  &kp LGUI  &kp LSHFT  &none  &kp LEFT  &kp DOWN  &kp UP  &kp RIGHT  &none  &none
                &none  &none  &none  &none  &none  &none  &kp C_MUTE  &mkp MCLK  &kp HOME  &kp PG_DN  &kp PG_UP  &kp END  &none  &none
                &trans  &none  &none  &mkp MCLK  &mkp RCLK  &mkp LCLK  &trans  &trans  &trans  &none  &none  &none
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &scroll_enc>;
        };

        nav_mac_layer {
            display-name = "NavMac";
            bindings = <
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp LG(LEFT)  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        fun_layer {
            display-name = "Fun";
            bindings = <
                &kp LC(LA(F13))  &m_email_p  &m_email_w  &kp LC(LA(F16))  &kp LC(LA(F17))  &none  &kp F12  &kp F7  &kp F8  &kp F9  &none  &bootloader
                &kp LC(LA(F14))  &kp LALT  &kp LCTRL  &kp LGUI  &kp LSHFT  &none  &kp F11  &kp F4  &kp F5  &kp F6  &none  &none
                &kp LC(LA(F15))  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_CLR  &none  &kp C_MUTE  &mkp MCLK  &kp F10  &kp F1  &kp F2  &kp F3  &none  &none
                &none  &none  &none  &trans  &none  &none  &none  &none  &none  &none  &none  &none
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &scroll_enc>;
        };

        num_layer {
            display-name = "Num";
            bindings = <
                &none  &m_000  &kp LCTRL  &kp LGUI  &kp LSHFT  &none  &kp ASTRK  &kp LBKT  &kp RBKT  &kp GRAVE  &kp BSLH  &kp BSPC
                &none  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5  &kp N6  &kp N7  &kp N8  &kp N9  &kp N0  &kp SQT
                &kp LSHFT  &none  &none  &kp LPAR  &kp RPAR  &kp ASTRK  &kp C_MUTE  &mkp MCLK  &kp EQUAL  &kp SQT  &kp LT  &kp DOT  &kp SEMI  &kp LT
                &none  &none  &none  &none  &none  &trans  &kp UNDER  &kp MINUS  &kp PLUS  &none  &none  &kp FSLH
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &scroll_enc>;
        };

        sym_layer {
            display-name = "Sym";
            bindings = <
                &kp ESC  &m_000  &kp LCTRL  &kp LGUI  &kp LSHFT  &none  &kp PLUS  &kp LBRC  &kp RBRC  &kp TILDE  &kp PIPE  &kp DEL
                &none  &kp EXCL  &kp AT  &kp HASH  &kp DLLR  &kp PRCNT  &kp CARET  &kp AMPS  &kp ASTRK  &kp LPAR  &kp RPAR  &kp UNDER
                &kp LSHFT  &none  &none  &none  &none  &none  &kp C_MUTE  &mkp MCLK  &trans  &trans  &kp LT  &kp GT  &kp COLON  &trans
                &none  &none  &none  &none  &trans  &none  &kp UNDER  &kp LPAR  &kp RPAR  &none  &none  &none
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &scroll_enc>;
        };

    };
};
